{
  "name": "daniel-kindl-portfolio",
  "type": "module",
  "version": "1.6.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26.3.0 <27"
  },
  "overrides": {
    "postcss": "^8.5.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check --minimumSeverity hint",
    "test": "node --test \"src/lib/*.test.ts\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
