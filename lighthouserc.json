{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/",
        "http://localhost/projects/ocho/",
        "http://localhost/writing/parent-killed-its-child/",
        "http://localhost/writing/",
        "http://localhost/search/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 96000 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 30000 }]
      }
    }
  }
}
