---

<script is:inline>
  const COLOR_SCHEME_QUERY = '(prefers-color-scheme: dark)';

  function getStoredTheme() {
    return typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
  }

  function getSystemTheme() {
    return window.matchMedia(COLOR_SCHEME_QUERY).matches ? 'dark' : 'light';
  }

  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#faf9f6');
  }

  // The single writer of the theme. The header toggle calls this rather than
  // setting data-theme itself, which is what the MutationObserver here used to
  // exist to reconcile.
  window.__setTheme = function (theme) {
    localStorage.setItem('theme', theme);
    applyTheme(theme);
  };

  // Applied, not persisted. Writing the system preference to localStorage on the
  // first visit pinned the theme forever, so the site stopped following the OS
  // after a single page view.
  applyTheme(getStoredTheme() || getSystemTheme());

  window.matchMedia(COLOR_SCHEME_QUERY).addEventListener('change', function (event) {
    if (!getStoredTheme()) applyTheme(event.matches ? 'dark' : 'light');
  });

  // Re-run setup on Astro View Transitions navigation events
  document.addEventListener('astro:after-swap', function () {
    applyTheme(getStoredTheme() || getSystemTheme());
  });
</script>
