---
import Tag from '../ui/Tag.astro';
import Button from '../ui/Button.astro';
import Typography from '../ui/Typography.astro';
import { slugify } from '@lib/slug';
import { formatDate, toIsoDate } from '@lib/formatDate';
import { getReadingTime } from '@lib/readingTime';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'writing'>;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}
const { post, headingLevel = 'h2', class: className = '' }: Props = Astro.props;
const readingTime = getReadingTime(post.body ?? '');
---

<article
  data-pagefind-ignore
  class={`border-b border-(--border-color) pb-8 last:border-0 ${className}`}
>
  <div class="flex flex-col gap-2">
    <p class="font-mono text-xs text-(--text-muted)">
      <time datetime={toIsoDate(post.data.date)}>{formatDate(post.data.date)}</time> · {readingTime} min
      read
    </p>
    <Typography variant="h2" as={headingLevel}>
      {post.data.title}
    </Typography>
    <p class="max-w-2xl text-sm leading-relaxed text-(--text-muted)">{post.data.summary}</p>
    {
      post.data.tags.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <Tag label={tag} href={`/writing/tags/${slugify(tag)}`} />
          ))}
        </div>
      )
    }
    <div class="mt-4">
      <Button href={`/writing/${post.id}`} variant="secondary">Read Post →</Button>
    </div>
  </div>
</article>
