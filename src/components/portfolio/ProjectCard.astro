---
import type { CollectionEntry } from 'astro:content';
import Typography from '@components/ui/Typography.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import ExternalLink from '@components/ui/ExternalLink.astro';
import { getProjectTimelineLabel } from '@lib/projectTimeline';
import { getProjectStatusLabel } from '@lib/projectStatus';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { project, index, headingLevel = 'h2', class: className = '' }: Props = Astro.props;
const isEven = index % 2 === 0;

const timelineLabel = getProjectTimelineLabel(project.data.dates);
const visibleStack = project.data.stack.slice(0, 4);
const hiddenStackCount = project.data.stack.length - visibleStack.length;
---

<article
  data-pagefind-ignore
  class={`grid grid-cols-1 md:grid-cols-12 gap-6 items-start border-b border-(--border-color) pb-12 last:border-0 ${isEven ? 'md:pt-4' : 'md:pt-16'} ${className}`}
>
  <div class={`md:col-span-7 flex flex-col ${isEven ? 'md:order-1' : 'md:order-2'}`}>
    <Typography variant="eyebrow"
      >Project {String(index + 1).padStart(2, '0')} · {project.data.role}</Typography
    >
    <Typography variant="h2" as={headingLevel} class="mb-4">
      {project.data.title}
    </Typography>
    <Typography variant="body" class="mb-6 max-w-xl text-(--text-muted)">
      {project.data.summary}
    </Typography>
    <div class="mb-6 flex flex-wrap gap-2">
      {visibleStack.map((tech: string) => <Tag label={tech} />)}
      {hiddenStackCount > 0 && <Tag label={`+${hiddenStackCount} more`} />}
    </div>
    <div class="flex gap-3">
      <Button href={`/projects/${project.id}`} variant="primary"> Read Case Study → </Button>
      {
        project.data.links?.repository && (
          <ExternalLink href={project.data.links.repository} variant="secondary">
            Repository
          </ExternalLink>
        )
      }
    </div>
    <div class="mt-4 font-mono text-[10px] text-(--text-muted) uppercase md:hidden">
      Status: {getProjectStatusLabel(project.data.status)} · Timeline: {timelineLabel}
    </div>
  </div>

  <div
    class={`hidden md:block md:col-span-5 font-mono text-[10px] text-(--text-muted) uppercase border-l border-(--border-color) pl-4 h-full self-stretch ${isEven ? 'md:order-2' : 'md:order-1'}`}
  >
    <div class="space-y-1">
      <div>Status: {getProjectStatusLabel(project.data.status)}</div>
      <div>Timeline: {timelineLabel}</div>
      <div>
        Stack: {project.data.stack.length}
        {project.data.stack.length === 1 ? 'technology' : 'technologies'}
      </div>
    </div>
  </div>
</article>
