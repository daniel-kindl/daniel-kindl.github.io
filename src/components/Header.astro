---
import { focusRingStyles } from '@lib/buttonStyles';
import Container from '@components/ui/Container.astro';

const navItems = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
  { href: '/search', label: 'Search' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="mb-12 w-full border-b border-(--border-color) py-4">
  <Container
    as="div"
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 font-mono text-xs tracking-tight"
  >
    <a
      href="/"
      class={`inline-flex min-h-[44px] items-center font-bold tracking-normal text-(--text-primary) uppercase transition-colors hover:underline active:underline ${focusRingStyles}`}
      >Daniel Kindl</a
    >

    <div class="flex flex-wrap items-center gap-2">
      <nav class="flex flex-wrap items-center gap-2">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={`inline-flex min-h-[44px] items-center px-1 uppercase transition-colors sm:px-3 ${focusRingStyles} ${
                isActive(item.href)
                  ? 'text-(--text-primary) underline decoration-(--text-primary) underline-offset-4'
                  : 'text-(--text-muted) hover:text-(--text-primary) active:text-(--text-primary)'
              }`}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <span aria-hidden="true" class="text-(--text-muted)">|</span>

      <button
        id="theme-toggle"
        class={`inline-flex min-h-[44px] cursor-pointer items-center px-1 text-(--text-muted) uppercase transition-colors hover:text-(--text-primary) active:text-(--text-primary) sm:px-3 ${focusRingStyles}`}
        aria-label="Toggle color theme"
        aria-pressed="false"
      >
        [<span class="theme-label-light">Light</span><span class="theme-label-dark">Dark</span>]
      </button>
    </div>
  </Container>
</header>

<script>
  function initializeThemeToggle() {
    const toggle = document.getElementById('theme-toggle');
    // astro:page-load fires on the initial load as well as after a navigation, so
    // this runs twice on a hard load. Marking the element makes the second run a
    // no-op — a swap brings an unmarked element, which rebinds correctly.
    if (!toggle || toggle.dataset.themeToggleBound === 'true') return;
    toggle.dataset.themeToggleBound = 'true';

    toggle.setAttribute(
      'aria-pressed',
      String(document.documentElement.getAttribute('data-theme') === 'dark'),
    );
    toggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      toggle.setAttribute('aria-pressed', String(next === 'dark'));
    });
  }

  // Fire on standard load and after Astro swaps components during navigation
  initializeThemeToggle();
  document.addEventListener('astro:page-load', initializeThemeToggle);
</script>
