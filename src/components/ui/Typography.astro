---
import type { HTMLAttributes } from 'astro/types';

// Exported because consumers need it — without forwarding, no `id`, `data-*` or
// `aria-*` could reach a heading, which is why projects/[id].astro hand-rolled
// headings as bare <div>s.
export type Props = HTMLAttributes<'div'> & {
  variant: 'h1' | 'h2' | 'h3' | 'body' | 'eyebrow' | 'mono';
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
};

const { variant, as, class: className = '', ...rest }: Props = Astro.props;

const styles = {
  h1: 'font-display text-3xl md:text-4xl font-bold uppercase tracking-tight text-(--text-primary)',
  h2: 'font-display text-xl md:text-2xl font-bold uppercase tracking-tight text-(--text-primary)',
  h3: 'font-display text-base md:text-lg font-bold uppercase tracking-tight text-(--text-primary)',
  body: 'text-base text-(--text-primary) leading-relaxed font-sans',
  eyebrow: 'font-display text-xs text-(--text-muted) uppercase tracking-wider block mb-2',
  mono: 'font-mono text-sm text-(--text-primary)',
};

const HeadingTag =
  variant === 'h1' || variant === 'h2' || variant === 'h3' ? (as ?? variant) : undefined;
const headingStyle = HeadingTag ? styles[variant] : '';
---

{
  HeadingTag && (
    <HeadingTag class={`${headingStyle} ${className}`} {...rest}>
      <slot />
    </HeadingTag>
  )
}
{
  variant === 'body' && (
    <p class={`${styles.body} ${className}`} {...rest}>
      <slot />
    </p>
  )
}
{
  variant === 'eyebrow' && (
    <span class={`${styles.eyebrow} ${className}`} {...rest}>
      <slot />
    </span>
  )
}
{
  variant === 'mono' && (
    <span class={`${styles.mono} ${className}`} {...rest}>
      <slot />
    </span>
  )
}
