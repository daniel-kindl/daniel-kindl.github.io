---
import { focusRingStyles } from '@lib/buttonStyles';

interface Props {
  label: string;
  href?: string;
}
const { label, href }: Props = Astro.props;

const chipClasses =
  'inline-flex min-h-[24px] items-center border border-(--text-muted) bg-(--bg-primary) px-2.5 py-1 font-mono text-[10px] tracking-tight text-(--text-muted) uppercase select-none transition-colors';
---

{
  href ? (
    <a
      href={href}
      class={`group inline-flex min-h-[44px] min-w-[44px] items-center justify-center ${focusRingStyles}`}
    >
      <span
        class={`${chipClasses} group-hover:border-(--text-primary) group-hover:text-(--text-primary) group-active:border-(--text-primary) group-active:text-(--text-primary)`}
      >
        {label}
      </span>
    </a>
  ) : (
    <span class={chipClasses}>{label}</span>
  )
}
