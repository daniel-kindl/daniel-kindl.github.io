---
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '@components/ThemeScript.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import { siteConfig } from '@lib/siteConfig';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Software engineer who designs systems, then builds them — combining hands-on engineering experience with AI-assisted development to ship and maintain production software.',
  ogImage = '/assets/meta/og-default.png',
}: Props = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth motion-safe:scroll-smooth motion-reduce:scroll-auto">
  <head>
    <!-- Base Configuration Targets -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="preload"
      href="/fonts/IBMPlexSans-VariableFont_wdth,wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/JetBrainsMono-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.feedTitle} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Core Runtime Utilities & Engine Routing -->
    <ThemeScript />
    <ClientRouter />

    <!-- Meta Indexing Titles -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph protocols -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter Platform Rules -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />
  </head>
  <body
    class="flex min-h-screen flex-col bg-(--bg-primary) text-(--text-primary) antialiased selection:bg-(--accent)/30 selection:text-(--text-primary)"
  >
    <!-- Skip to main content link for screen-readers -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-(--accent) focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-black"
    >
      [SKIP_TO_CONTENT]
    </a>

    <Header />

    <!-- data-pagefind-body belongs on the pages that carry prose, not here: on
         <main> every route is indexed, so 22 of 32 entries were 8-27 word stubs
         and a search for a common word could surface the 404 page. -->
    <!-- tabindex="-1" so the skip link moves focus here rather than only
         scrolling; without it the next Tab returns to the header. -->
    <main id="main-content" tabindex="-1" class="grow">
      <slot />
    </main>

    <Footer />

    <script>
      function initCodeCopyButtons() {
        const blocks = document.querySelectorAll<HTMLPreElement>('.prose pre');

        blocks.forEach((pre) => {
          if (pre.closest('.code-block-wrapper')) return;

          // The button must anchor to a non-scrolling wrapper, not to `pre`
          // itself — `pre` is the horizontally-scrolling element, so a button
          // absolutely positioned against it scrolls away with the code.
          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper group relative';
          pre.replaceWith(wrapper);
          wrapper.appendChild(pre);

          const button = document.createElement('button');
          button.type = 'button';
          button.className =
            'copy-code-button absolute right-2 top-2 flex min-h-[44px] min-w-[44px] items-center justify-center border border-(--border-color) bg-(--bg-primary) px-2 font-mono text-[10px] uppercase tracking-tight text-(--text-muted) opacity-0 transition-opacity duration-150 group-hover:opacity-100 hover:border-(--text-primary) hover:text-(--text-primary) focus-visible:opacity-100 [@media(hover:none)]:opacity-100 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--accent-focus)';
          button.textContent = '[Copy]';
          button.setAttribute('aria-label', 'Copy code to clipboard');

          button.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.textContent ?? '';
            try {
              await navigator.clipboard.writeText(code);
              button.textContent = '[Copied]';
            } catch {
              button.textContent = '[Failed]';
            }
            setTimeout(() => {
              button.textContent = '[Copy]';
            }, 1500);
          });

          wrapper.appendChild(button);
        });
      }

      initCodeCopyButtons();
      document.addEventListener('astro:page-load', initCodeCopyButtons);
    </script>
  </body>
</html>
