---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Typography from '@components/ui/Typography.astro';
import Tag from '@components/ui/Tag.astro';
import { pageTitle } from '@lib/siteConfig';

const stack = ['Astro 7', 'TypeScript (strict)', 'Tailwind CSS 4', 'Pagefind'];
const fonts = ['Space Grotesk', 'JetBrains Mono', 'IBM Plex Sans'];
---

<Layout
  title={pageTitle('Colophon')}
  description="What this site is actually built with: stack, architecture, and CI/CD pipeline."
>
  <Container class="py-12 md:py-20">
    <header class="mb-16 border-b border-(--border-color) pb-12">
      <Typography variant="eyebrow">Colophon</Typography>
      <Typography variant="h1" class="mb-6">
        How This Site Is Built
      </Typography>
      <div class="max-w-2xl space-y-4">
        <Typography variant="body" class="text-(--text-muted)">
          A short reference for what's actually running this site, for anyone curious about the
          stack behind it.
        </Typography>
      </div>
    </header>

    <section class="mb-16 max-w-3xl">
      <div class="mb-8">
        <Typography variant="eyebrow">Stack</Typography>
        <Typography variant="h2">What It Runs On</Typography>
      </div>
      <div class="flex flex-wrap gap-2">
        {stack.map((item) => (
          <Tag label={item} />
        ))}
      </div>
    </section>

    <section class="mb-16 max-w-3xl">
      <div class="mb-8">
        <Typography variant="eyebrow">Architecture</Typography>
        <Typography variant="h2">Content & Structure</Typography>
      </div>
      <ul class="list-disc space-y-3 pl-5 text-sm leading-relaxed text-(--text-muted)">
        <li>
          Two Zod-validated content collections, <code>projects</code> and <code>writing</code>,
          power every case study and post through Astro's Content Collections API. No CMS, just MDX
          files checked into the repo.
        </li>
        <li>
          Theming uses a <code>data-theme</code> attribute and CSS custom properties, not Tailwind's
          <code>.dark</code> class. The first visit follows your system preference; after that the
          toggle persists to <code>localStorage</code>.
        </li>
        <li>
          Icons and the social-share image are files in the repository. Every page uses the same
          share image. The title and the description still change on each page.
        </li>
        <li>
          Search is static: Pagefind indexes the built HTML after every build and ships its own
          small WASM search index, no server or third-party search API involved.
        </li>
      </ul>
    </section>

    <section class="mb-16 max-w-3xl">
      <div class="mb-8">
        <Typography variant="eyebrow">Pipeline</Typography>
        <Typography variant="h2">CI/CD</Typography>
      </div>
      <ul class="list-disc space-y-3 pl-5 text-sm leading-relaxed text-(--text-muted)">
        <li>
          The repo lives on GitHub, which hosts the code, the pull requests, and the CI. The site is
          served from GitHub Pages on a custom domain.
        </li>
        <li>
          Pull requests run lint, format checks, type checks, and tests, then a full production
          build, before merge.
        </li>
        <li>
          A push to <code>master</code> builds the site and deploys that build to GitHub Pages.
          Lighthouse checks five pages in its own workflow. A failed check does not stop the deploy.
        </li>
      </ul>
    </section>

    <section class="mb-16 max-w-3xl">
      <div class="mb-8">
        <Typography variant="eyebrow">Privacy</Typography>
        <Typography variant="h2">Visitor data</Typography>
      </div>
      <ul class="list-disc space-y-3 pl-5 text-sm leading-relaxed text-(--text-muted)">
        <li>
          Cloudflare Web Analytics runs on this site. It loads a script from
          <code>static.cloudflareinsights.com</code> and sends page-load data to Cloudflare.
        </li>
        <li>This site sets no cookies.</li>
        <li>
          The site stores your theme choice in <code>localStorage</code>, in your browser only.
        </li>
        <li>Cloudflare sits in front of the site and processes each request to it.</li>
        <li>
          Cloudflare sends a header that asks your browser to report failed connections to
          Cloudflare.
        </li>
      </ul>
    </section>

    <section class="mb-16 max-w-3xl">
      <div class="mb-8">
        <Typography variant="eyebrow">Reuse</Typography>
        <Typography variant="h2">License</Typography>
      </div>
      <ul class="list-disc space-y-3 pl-5 text-sm leading-relaxed text-(--text-muted)">
        <li>The code of this site is under the MIT License.</li>
        <li>
          The blog posts are under the Creative Commons Attribution 4.0 license (CC BY 4.0). You can
          share and adapt them if you give credit.
        </li>
        <li>
          The CV text, the bio, the personal images, and the logo are not licensed for reuse. All
          rights are reserved.
        </li>
      </ul>
    </section>

    <section class="max-w-3xl">
      <div class="mb-8">
        <Typography variant="eyebrow">Typefaces</Typography>
        <Typography variant="h2">Fonts</Typography>
      </div>
      <div class="flex flex-wrap gap-2">
        {fonts.map((item) => (
          <Tag label={item} />
        ))}
      </div>
      <p class="mt-4 text-sm leading-relaxed text-(--text-muted)">
        All three are SIL OFL licensed and self-hosted as variable fonts, no Google Fonts CDN.
      </p>
    </section>
  </Container>
</Layout>
