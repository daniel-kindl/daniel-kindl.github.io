---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Typography from '../../components/ui/Typography.astro';
import Tag from '../../components/ui/Tag.astro';
import Button from '../../components/ui/Button.astro';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import TableOfContents from '../../components/ui/TableOfContents.astro';
import { getProjectTimelineLabel } from '@lib/projectTimeline';
import { getProjectStatusLabel } from '@lib/projectStatus';
import { getReadingTime } from '@lib/readingTime';
import { getTocHeadings, hasToc as hasTocEntries } from '@lib/toc';
import { getRelatedPosts, getSortedProjects } from '@lib/content';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

const timelineLabel = getProjectTimelineLabel(project.data.dates);
const readingTime = getReadingTime(project.body ?? '');
const tocHeadings = getTocHeadings(headings);
const hasToc = hasTocEntries(tocHeadings);

const relatedPosts = await getRelatedPosts(project.id);

// The primary CTA follows evidentiary weight, not field order: prefer a live
// production link, then a repository (verifiable code/CI), then a release.
const primaryLinkKey = project.data.links?.production
  ? 'production'
  : project.data.links?.repository
    ? 'repository'
    : project.data.links?.release
      ? 'release'
      : null;

// Real evidence for the metadata band: which verifiable links back this
// project, rather than re-deriving the stack count already shown in tags.
const linkLabels = [
  project.data.links?.production && 'Live',
  project.data.links?.repository && 'Repository',
  project.data.links?.release && 'Release',
].filter((label): label is string => Boolean(label));
---

<Layout
  title={`${project.data.title} — Case Study`}
  ogImage={`/assets/meta/og/projects/${project.id}.png`}
>
  <article data-pagefind-body>
    <div class="border-b border-(--border-color) bg-(--bg-primary) py-12 md:py-20">
      <Container>
        <div class="mb-4">
          <Button href="/projects" variant="link">← Back to Projects</Button>
        </div>
        <Typography variant="eyebrow">
          Case Study · {project.data.role} · {readingTime} min read
        </Typography>
        <Typography variant="h1" class="mb-6 max-w-4xl">
          {project.data.title}
        </Typography>
        <div class="mb-6 flex flex-wrap gap-2">
          {project.data.stack.map((tech: string) => <Tag label={tech} />)}
        </div>
        <div class="flex flex-wrap gap-3">
          {
            project.data.links?.repository && (
              <ExternalLink
                href={project.data.links.repository}
                variant={primaryLinkKey === 'repository' ? 'primary' : 'secondary'}
              >
                View Repository
              </ExternalLink>
            )
          }
          {
            project.data.links?.production && (
              <ExternalLink
                href={project.data.links.production}
                variant={primaryLinkKey === 'production' ? 'primary' : 'secondary'}
              >
                View Live
              </ExternalLink>
            )
          }
          {
            project.data.links?.release && (
              <ExternalLink
                href={project.data.links.release}
                variant={primaryLinkKey === 'release' ? 'primary' : 'secondary'}
              >
                View Release
              </ExternalLink>
            )
          }
        </div>
      </Container>
    </div>

    <div
      class="border-b border-(--border-color) bg-(--bg-primary) py-8 font-mono text-[10px] text-(--text-muted)"
    >
      {
        /* A <div> wrapping each <dt>/<dd> pair is valid inside <dl> and keeps the
          grid items intact, so the band gains description-list semantics without
          any layout change. */
      }
      <Container as="dl" class="grid grid-cols-2 gap-6 md:grid-cols-4">
        <div class="border-l border-(--border-color) pl-4">
          <dt class="mb-1 font-bold text-(--text-primary) uppercase">Role</dt>
          <dd>{project.data.role}</dd>
        </div>
        <div class="border-l border-(--border-color) pl-4">
          <dt class="mb-1 font-bold text-(--text-primary) uppercase">Timeline</dt>
          <dd>{timelineLabel}</dd>
        </div>
        <div class="border-l border-(--border-color) pl-4">
          <dt class="mb-1 font-bold text-(--text-primary) uppercase">Links</dt>
          <dd>{linkLabels.length > 0 ? linkLabels.join(' · ') : 'None public'}</dd>
        </div>
        <div class="border-l border-(--border-color) pl-4">
          <dt class="mb-1 font-bold text-(--text-primary) uppercase">Status</dt>
          <dd>{getProjectStatusLabel(project.data.status).toUpperCase()}</dd>
        </div>
      </Container>
    </div>

    <Container class="py-12 md:py-16">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
        <div class="md:col-span-8">
          {hasToc && <TableOfContents headings={tocHeadings} variant="mobile" />}
          <div class="prose max-w-none">
            <Content />
          </div>
        </div>

        <aside
          class="h-fit space-y-4 border-l border-(--border-color) pl-6 font-mono text-[10px] text-(--text-muted) md:sticky md:top-6 md:col-span-4"
        >
          {
            hasToc && (
              <div class="hidden md:block">
                <TableOfContents headings={tocHeadings} variant="desktop" />
              </div>
            )
          }
          <div>
            <div class="mb-1 font-bold text-(--text-primary)">Summary</div>
            <p class="text-sm leading-relaxed">{project.data.summary}</p>
          </div>
          {
            relatedPosts.length > 0 && (
              <div>
                <div class="mb-2 font-bold text-(--text-primary)">Related Writing</div>
                <ul class="space-y-2">
                  {relatedPosts.map((post) => (
                    <li>
                      <a
                        href={`/writing/${post.id}`}
                        class="leading-relaxed text-(--text-primary) underline decoration-(--border-color) underline-offset-2 hover:decoration-(--text-primary)"
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </Container>
  </article>
</Layout>
