---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Typography from '../../components/ui/Typography.astro';
import Tag from '../../components/ui/Tag.astro';
import Button from '../../components/ui/Button.astro';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import { getProjectTimelineLabel } from '@lib/projectTimeline';
import { getProjectStatusLabel } from '@lib/projectStatus';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const timelineLabel = getProjectTimelineLabel(project.data.dates);

const relatedPosts = (await getCollection('writing')).filter(
  (post) => (!post.data.draft || import.meta.env.DEV) && post.data.project?.id === project.id,
);

// The primary CTA follows evidentiary weight, not field order: prefer a live
// production link, then a repository (verifiable code/CI), then a release.
const primaryLinkKey = project.data.links?.production
  ? 'production'
  : project.data.links?.repository
    ? 'repository'
    : project.data.links?.release
      ? 'release'
      : null;

// Real evidence for the metadata band: which verifiable links back this
// project, rather than re-deriving the stack count already shown in tags.
const linkLabels = [
  project.data.links?.production && 'Live',
  project.data.links?.repository && 'Repository',
  project.data.links?.release && 'Release',
].filter((label): label is string => Boolean(label));
---

<Layout
  title={`${project.data.title} — Case Study`}
  ogImage={`/assets/meta/og/projects/${project.id}.png`}
>
  <article>
    <div class="border-b border-(--border-color) bg-(--bg-primary) py-12 md:py-20">
      <Container>
        <div class="mb-4">
          <Button href="/projects" variant="secondary" class="min-w-0! px-0!"
            >← Back to Projects</Button
          >
        </div>
        <Typography variant="eyebrow">Case Study · {project.data.role}</Typography>
        <Typography variant="h1" class="mb-6 max-w-4xl">
          {project.data.title}
        </Typography>
        <div class="mb-6 flex flex-wrap gap-2">
          {project.data.stack.map((tech: string) => <Tag label={tech} />)}
        </div>
        <div class="flex gap-3">
          {
            project.data.links?.repository && (
              <ExternalLink
                href={project.data.links.repository}
                variant={primaryLinkKey === 'repository' ? 'primary' : 'secondary'}
              >
                View Repository
              </ExternalLink>
            )
          }
          {
            project.data.links?.production && (
              <ExternalLink
                href={project.data.links.production}
                variant={primaryLinkKey === 'production' ? 'primary' : 'secondary'}
              >
                View Live
              </ExternalLink>
            )
          }
          {
            project.data.links?.release && (
              <ExternalLink
                href={project.data.links.release}
                variant={primaryLinkKey === 'release' ? 'primary' : 'secondary'}
              >
                View Release
              </ExternalLink>
            )
          }
        </div>
      </Container>
    </div>

    <div
      class="border-b border-(--border-color) bg-(--bg-primary) py-8 font-mono text-[11px] text-(--text-muted)"
    >
      <Container class="grid grid-cols-2 gap-6 md:grid-cols-4">
        <div class="border-l border-(--border-color) pl-4">
          <div class="mb-1 font-bold text-(--text-primary) uppercase">Role</div>
          <div>{project.data.role}</div>
        </div>
        <div class="border-l border-(--border-color) pl-4">
          <div class="mb-1 font-bold text-(--text-primary) uppercase">Timeline</div>
          <div>{timelineLabel}</div>
        </div>
        <div class="border-l border-(--border-color) pl-4">
          <div class="mb-1 font-bold text-(--text-primary) uppercase">Links</div>
          <div>{linkLabels.length > 0 ? linkLabels.join(' · ') : 'None public'}</div>
        </div>
        <div class="border-l border-(--border-color) pl-4">
          <div class="mb-1 font-bold text-(--text-primary) uppercase">Status</div>
          <div>{getProjectStatusLabel(project.data.status).toUpperCase()}</div>
        </div>
      </Container>
    </div>

    <Container class="py-12 md:py-16">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
        <div class="prose max-w-none md:col-span-8">
          <Content />
        </div>

        <aside
          class="h-fit space-y-4 border-l border-(--border-color) pl-6 font-mono text-[10px] text-(--text-muted) md:sticky md:top-6 md:col-span-4"
        >
          <div>
            <div class="mb-1 font-bold text-(--text-primary)">Summary</div>
            <p class="leading-relaxed">{project.data.summary}</p>
          </div>
          {
            relatedPosts.length > 0 && (
              <div>
                <div class="mb-2 font-bold text-(--text-primary)">Related Writing</div>
                <ul class="space-y-2">
                  {relatedPosts.map((post) => (
                    <li>
                      <a
                        href={`/writing/${post.id}`}
                        class="leading-relaxed text-(--text-primary) underline decoration-(--border-color) underline-offset-2 hover:decoration-(--text-primary)"
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </Container>
  </article>
</Layout>
