---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Typography from '../../components/ui/Typography.astro';
import Tag from '../../components/ui/Tag.astro';
import Button from '../../components/ui/Button.astro';
import TableOfContents from '../../components/ui/TableOfContents.astro';
import { slugify } from '@lib/slug';
import { getPublishedPosts } from '@lib/content';
import { formatDate, toIsoDate } from '@lib/formatDate';
import { getReadingTime } from '@lib/readingTime';
import { getTocHeadings, hasToc as hasTocEntries } from '@lib/toc';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const relatedProject = post.data.project ? await getEntry(post.data.project) : undefined;
const readingTime = getReadingTime(post.body ?? '');
const tocHeadings = getTocHeadings(headings);
const hasToc = hasTocEntries(tocHeadings);
---

<Layout
  title={`${post.data.title} — Writing`}
  description={post.data.summary}
  ogImage={`/assets/meta/og/writing/${post.id}.png`}
>
  <article data-pagefind-body>
    <div class="border-b border-(--border-color) bg-(--bg-primary) py-12 md:py-20">
      <Container>
        <div class="mb-4">
          <Button href="/writing" variant="secondary" class="min-w-0! px-0!"
            >← Back to Writing</Button
          >
        </div>
        <Typography variant="eyebrow">
          <time datetime={toIsoDate(post.data.date)}>{formatDate(post.data.date)}</time> · {
            readingTime
          } min read
          {
            post.data.updated && (
              <>
                {' · Updated '}
                <time datetime={toIsoDate(post.data.updated)}>{formatDate(post.data.updated)}</time>
              </>
            )
          }
        </Typography>
        <Typography variant="h1" class="mb-6 max-w-4xl">{post.data.title}</Typography>
        {
          post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag: string) => (
                <Tag label={tag} href={`/writing/tags/${slugify(tag)}`} />
              ))}
            </div>
          )
        }
      </Container>
    </div>

    <Container class="py-12 md:py-16">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
        <div class={hasToc ? 'md:col-span-8' : 'md:col-span-12'}>
          {hasToc && <TableOfContents headings={tocHeadings} variant="mobile" />}
          <div class="prose max-w-none md:max-w-3xl">
            <Content />
          </div>
          <div class="mt-12 max-w-3xl border-t border-(--border-color) pt-8">
            {
              relatedProject ? (
                <>
                  <p class="mb-3 font-mono text-xs text-(--text-muted) uppercase">
                    Related Project
                  </p>
                  <Button href={`/projects/${relatedProject.id}`} variant="secondary">
                    {relatedProject.data.title} →
                  </Button>
                </>
              ) : (
                <Button href="/writing" variant="secondary">
                  More Writing →
                </Button>
              )
            }
          </div>
        </div>

        {
          hasToc && (
            <div class="sticky top-6 hidden h-fit border-l border-(--border-color) pl-6 md:col-span-4 md:block">
              <TableOfContents headings={tocHeadings} variant="desktop" />
            </div>
          )
        }
      </div>
    </Container>
  </article>
</Layout>
