---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Typography from '@components/ui/Typography.astro';
import Timeline from '@components/ui/Timeline.astro';
import TimelineEvent from '@components/ui/TimelineEvent.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import ExternalLink from '@components/ui/ExternalLink.astro';
import { technicalProfile } from '../data/cv';
import { mailto, pageTitle, siteConfig } from '@lib/siteConfig';
import { buttonVariants } from '@lib/buttonStyles';

const { name, role, location, summary, intro, principles, focus, employer, skills, agentBuilt } =
  technicalProfile;

// Entries are ordered most-recent-first; flag a promotion when consecutive
// entries share an employer so the timeline reads as one continuous tenure.
const experience = technicalProfile.experience.map((item, index, all) => {
  const previous = all[index + 1];
  const promotedFrom = previous && previous.company === item.company ? previous.role : undefined;
  return { ...item, promotedFrom };
});

const linkClass = buttonVariants.link;

const readout = [
  { label: 'Role', value: role },
  { label: 'Based in', value: location },
  { label: 'Experience', value: `${technicalProfile.experienceYears} years` },
  { label: 'Core stack', value: technicalProfile.coreStack.join(' · ') },
  { label: 'Now', value: technicalProfile.now },
];
---

<Layout title={pageTitle('About')} description={summary}>
  <Container class="py-12 md:py-20" data-pagefind-body>
    <header class="mb-16 border-b border-(--border-color) pb-12">
      <Typography variant="eyebrow">About</Typography>
      <Typography variant="h1" class="mb-8">
        {name}
      </Typography>
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-6">
        <div class="md:col-span-8">
          <div class="max-w-2xl space-y-4">
            {intro.map((paragraph, index) => (
              <Typography variant="body" class={index === 0 ? 'text-lg' : ''}>
                {paragraph}
              </Typography>
            ))}
          </div>
          <div class="mt-8">
            <Button href="/cv" variant="primary">
              View CV
            </Button>
          </div>
        </div>

        <!-- The readout: the project card's metadata rail, reused for the facts a
             recruiter scans first. A top rule replaces the left rail on mobile. -->
        <aside
          aria-label="Profile summary"
          class="border-t border-(--border-color) pt-6 font-mono text-xs md:col-span-4 md:border-t-0 md:border-l md:pt-0 md:pl-6"
        >
          <dl class="space-y-4">
            {readout.map((row) => (
              <div>
                <dt class="text-[10px] tracking-wider text-(--text-muted) uppercase">
                  {row.label}
                </dt>
                <dd class="mt-0.5 text-(--text-primary)">{row.value}</dd>
              </div>
            ))}
          </dl>
          <ul class="mt-6 flex flex-wrap gap-x-4 uppercase">
            <li>
              <a href={mailto} class={`inline-flex items-center ${linkClass}`}>
                Email
              </a>
            </li>
            <li>
              <ExternalLink href={siteConfig.socials.github} variant="link">
                GitHub
              </ExternalLink>
            </li>
            <li>
              <ExternalLink href={siteConfig.socials.linkedin} variant="link">
                LinkedIn
              </ExternalLink>
            </li>
          </ul>
        </aside>
      </div>
    </header>

    <section class="mb-16 border-b border-(--border-color) pb-16" aria-labelledby="how-i-work">
      <div class="mb-8">
        <Typography variant="eyebrow">Principles</Typography>
        <Typography variant="h2" id="how-i-work">
          How I Work
        </Typography>
      </div>
      <ol class="grid gap-10 md:grid-cols-2">
        {principles.map((principle, index) => (
          <li class="border-l border-(--border-color) pl-6">
            <span class="font-mono text-[10px] tracking-wider text-(--text-muted) uppercase tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
            <Typography variant="h3" as="h3" class="mt-1 mb-3">
              {principle.title}
            </Typography>
            <Typography variant="body" class="text-(--text-muted)">
              {principle.body}
            </Typography>
            <ul class="mt-2 flex flex-wrap gap-x-4 font-mono text-xs tracking-tight">
              {principle.evidence.map((link) => (
                <li>
                  <a href={link.href} class={linkClass}>
                    {link.label} →
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="mb-16 border-b border-(--border-color) pb-16" aria-labelledby="current-focus">
      <div class="max-w-3xl">
        <div class="mb-8">
          <Typography variant="eyebrow">Focus</Typography>
          <Typography variant="h2" id="current-focus">
            Current Focus
          </Typography>
        </div>
        <dl class="space-y-6">
          <div>
            <dt class="mb-1 font-mono text-xs text-(--text-muted) uppercase">At work</dt>
            <dd>
              <Typography variant="body">{focus.work}</Typography>
            </dd>
          </div>
          <div>
            <dt class="mb-1 font-mono text-xs text-(--text-muted) uppercase">Exploring</dt>
            <dd>
              <Typography variant="body">{focus.exploring}</Typography>
            </dd>
          </div>
          <div>
            <dt class="mb-1 font-mono text-xs text-(--text-muted) uppercase">On the side</dt>
            <dd>
              <Typography variant="body">{focus.sideIntro}</Typography>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-(--text-primary)">
                {focus.side.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <Typography variant="body" class="mt-3 text-(--text-muted)">
                My public work is on the{' '}
                <a href="/projects" class={linkClass}>
                  Projects
                </a>{' '}
                page.
              </Typography>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="mb-16 border-b border-(--border-color) pb-16" aria-labelledby="experience">
      <div class="max-w-3xl">
        <div class="mb-8">
          <Typography variant="eyebrow">Work History</Typography>
          <Typography variant="h2" id="experience">
            Experience
          </Typography>
        </div>
        <Typography variant="body" class="mb-2">
          <strong>{employer.name}</strong>, {employer.location}
        </Typography>
        <Typography variant="body" class="text-sm text-(--text-muted)">
          {employer.context}
        </Typography>

        <Timeline>
          {experience.map((item) => (
            <TimelineEvent title={item.role} time={item.period} promotedFrom={item.promotedFrom}>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-(--text-muted)">
                {item.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </TimelineEvent>
          ))}
        </Timeline>
      </div>
    </section>

    <section class="mb-16 border-b border-(--border-color) pb-16" aria-labelledby="skills">
      <div class="mb-8">
        <Typography variant="eyebrow">Skills</Typography>
        <Typography variant="h2" id="skills">
          Technical Toolkit
        </Typography>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {skills.map((group) => (
          <div>
            <h3 class="mb-3 font-mono text-xs text-(--text-muted) uppercase">{group.label}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <Tag label={item} />
              ))}
            </div>
          </div>
        ))}
      </div>
      <Typography variant="body" class="mt-10 max-w-2xl text-sm text-(--text-muted)">
        <strong class="text-(--text-primary)">Built with AI agents, outside my core stack:</strong>{' '}
        {agentBuilt.map((entry, index) => (
          <span>
            {`${index > 0 ? '; ' : ''}${entry.stack} (`}
            {entry.href ? (
              <a href={entry.href} class={linkClass}>
                {entry.where}
              </a>
            ) : (
              entry.where
            )}
            {index === agentBuilt.length - 1 ? ').' : ')'}
          </span>
        ))}
      </Typography>
    </section>

    <section aria-labelledby="contact">
      <Typography variant="eyebrow">Contact</Typography>
      <Typography variant="h2" id="contact" class="mb-6">
        Get in Touch
      </Typography>
      <div class="flex flex-wrap gap-4">
        <Button href={mailto} variant="primary">
          {siteConfig.email}
        </Button>
        <Button href="/cv" variant="secondary">
          View CV
        </Button>
      </div>
    </section>
  </Container>
</Layout>
