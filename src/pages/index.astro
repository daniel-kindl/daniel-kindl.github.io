---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Typography from '@components/ui/Typography.astro';
import Button from '@components/ui/Button.astro';
import ProjectCard from '@components/portfolio/ProjectCard.astro';
import WritingPostCard from '@components/portfolio/WritingPostCard.astro';
import { getPublishedPosts, getSortedProjects } from '@lib/content';
import { mailto } from '@lib/siteConfig';

const allProjects = await getSortedProjects();
const allPosts = await getPublishedPosts();
const features = allProjects.slice(0, 2);
const recentPosts = allPosts.slice(0, 2);
---

<Layout title="Daniel Kindl — Software Engineer">
  <div class="relative flex min-h-[70dvh] w-full items-center border-b border-(--border-color)">
    <Container class="py-20">
      <Typography variant="eyebrow">Software Engineer</Typography>
      <Typography
        variant="h1"
        class="mb-6 max-w-3xl text-4xl leading-tight font-bold sm:leading-none md:text-6xl"
      >
        I design systems, <span class="text-(--text-muted)">then build them</span>.
      </Typography>
      <Typography variant="body" class="mb-6 max-w-xl text-(--text-muted)">
        Software engineer building and shipping useful software across platforms. I choose the tools
        that fit the problem, and use agentic development inside a structured engineering workflow.
      </Typography>
      <Typography variant="mono" class="mb-12 block text-(--text-muted)">
        [{allProjects.length} projects · {allPosts.length} engineering write-ups]
      </Typography>
      <div class="flex gap-4">
        <Button href="/projects" variant="primary">
          View Projects
        </Button>
        <Button href="/about" variant="secondary">
          About & CV
        </Button>
      </div>
    </Container>
  </div>

  <Container as="section" class="border-b border-(--border-color) py-20">
    <header class="reveal mb-12 flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
      <div>
        <Typography variant="eyebrow">Selected Work</Typography>
        <Typography variant="h2">Recent Project Highlights</Typography>
      </div>
      <Button href="/projects" variant="secondary" class="self-start sm:self-auto">
        All Projects →
      </Button>
    </header>

    <div class="space-y-12">
      {features.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          headingLevel="h3"
          class={`reveal ${index === 1 ? 'delay-150' : ''}`}
        />
      ))}
    </div>
  </Container>

  <Container as="section" class="border-b border-(--border-color) py-20">
    <header class="reveal mb-12 flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
      <div>
        <Typography variant="eyebrow">Latest Writing</Typography>
        <Typography variant="h2">Recent Write-Ups</Typography>
      </div>
      <Button href="/writing" variant="secondary" class="self-start sm:self-auto">
        All Writing →
      </Button>
    </header>

    <div class="space-y-12">
      {recentPosts.map((post, index) => (
        <WritingPostCard
          post={post}
          headingLevel="h3"
          class={`reveal ${index === 1 ? 'delay-150' : ''}`}
        />
      ))}
    </div>
  </Container>

  <Container as="section" class="py-20">
    <div class="reveal max-w-3xl border border-(--border-color) bg-(--bg-primary) p-8 md:p-12">
      <Typography variant="eyebrow">How I Work</Typography>
      <Typography variant="h2" class="mb-4">
        Scoped work, then a pull request
      </Typography>
      <Typography variant="body" class="mb-4 text-(--text-muted)">
        I open the work as a GitHub issue before an agent starts. Repository instructions state the
        boundaries: the architecture, the verification command, and the decisions the change has to
        keep. The normal end of the task is a pull request.
      </Typography>
      <Typography variant="body" class="mb-4 text-(--text-muted)">
        The verification command runs before merge. This site runs
        <span class="font-mono text-sm">npm run check</span> and a production build.
        <a
          class="underline decoration-(--border-color) underline-offset-2 hover:decoration-(--text-primary)"
          href="/projects/startup-exe"
        >
          startup.exe
        </a>
        runs <span class="font-mono text-sm">./eng/verify.sh</span>, which checks formatting, builds
        Release, and runs the tests.
        <a
          class="underline decoration-(--border-color) underline-offset-2 hover:decoration-(--text-primary)"
          href="/projects/mazelab"
        >
          MazeLab
        </a>
        runs formatting, Clippy, and the test suite. I add a separate review when a change is easy
        to get subtly wrong. Agents can draft the research, the code, and the tests. Merge waits on
        the verification command, and on that review when I asked for one.
      </Typography>
      <Typography variant="body" class="mb-6 text-(--text-muted)">
        I keep the workflows repeatable. MazeLab rebuilds one maze from a seed, a size, and a
        version. startup.exe replays a seed and an ordered action list, and it keeps the playtest
        artifacts.
        <a
          class="underline decoration-(--border-color) underline-offset-2 hover:decoration-(--text-primary)"
          href="/projects/dk-devkit"
        >
          dk-devkit
        </a>
        installs from declared components, runs unattended work on a disposable clone, and keeps
        GitHub push and merge authority in the trusted layer. Milestone notes and project docs
        record the decision, so the next session can start from the repository.
      </Typography>
      <Button href={mailto} variant="primary">
        Get in touch
      </Button>
    </div>
  </Container>
</Layout>

<script>
  let revealObserver: IntersectionObserver | null = null;

  function initScrollReveal() {
    // The bare call below is load-bearing: astro:page-load fires on window `load`,
    // by which point the page has painted, so hiding there would flash the content
    // in and straight back out. This guard stops that later run from re-hiding
    // what has already been revealed, and from stacking a second observer.
    if (revealObserver) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const elements = document.querySelectorAll<HTMLElement>('.reveal');

    if (prefersReducedMotion || elements.length === 0) return;

    elements.forEach((el) => el.classList.add('reveal-hidden'));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.remove('reveal-hidden');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
    );

    revealObserver = observer;
    elements.forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:before-swap', () => {
    revealObserver?.disconnect();
    revealObserver = null;
  });

  initScrollReveal();
  document.addEventListener('astro:page-load', initScrollReveal);
</script>
