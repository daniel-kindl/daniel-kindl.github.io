---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Typography from '@components/ui/Typography.astro';
import Button from '@components/ui/Button.astro';
import ProjectCard from '@components/portfolio/ProjectCard.astro';
import WritingPostCard from '@components/portfolio/WritingPostCard.astro';
import { getPublishedPosts, getSortedProjects } from '@lib/content';
import { mailto } from '@lib/siteConfig';

const allProjects = await getSortedProjects();
const allPosts = await getPublishedPosts();
const features = allProjects.slice(0, 2);
const recentPosts = allPosts.slice(0, 2);
---

<Layout title="Daniel Kindl — Software Engineer">
  <div class="relative flex min-h-[70dvh] w-full items-center border-b border-(--border-color)">
    <Container class="py-20">
      <Typography variant="eyebrow">Software Engineer</Typography>
      <Typography
        variant="h1"
        class="mb-6 max-w-3xl text-4xl leading-tight font-bold sm:leading-none md:text-6xl"
      >
        I design systems, <span class="text-(--text-muted)">then build them</span>.
      </Typography>
      <Typography variant="body" class="mb-6 max-w-xl text-(--text-muted)">
        Software engineer building and shipping useful software across platforms. I choose the tools
        that fit the problem.
      </Typography>
      <Typography variant="mono" class="mb-12 block text-(--text-muted)">
        [{allProjects.length} shipped projects · {allPosts.length} engineering write-ups]
      </Typography>
      <div class="flex gap-4">
        <Button href="/projects" variant="primary">View Projects</Button>
        <Button href="/about" variant="secondary">About & CV</Button>
      </div>
    </Container>
  </div>

  <Container as="section" class="border-b border-(--border-color) py-20">
    <header
      class="reveal mb-12 flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between"
    >
      <div>
        <Typography variant="eyebrow">Selected Work</Typography>
        <Typography variant="h2">Recent Project Highlights</Typography>
      </div>
      <Button href="/projects" variant="secondary" class="self-start sm:self-auto">
        All Projects →
      </Button>
    </header>

    <div class="space-y-12">
      {
        features.map((project, index) => (
          <ProjectCard
            project={project}
            index={index}
            headingLevel="h3"
            class={`reveal ${index === 1 ? 'delay-150' : ''}`}
          />
        ))
      }
    </div>
  </Container>

  <Container as="section" class="border-b border-(--border-color) py-20">
    <header
      class="reveal mb-12 flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between"
    >
      <div>
        <Typography variant="eyebrow">Latest Writing</Typography>
        <Typography variant="h2">Recent Write-Ups</Typography>
      </div>
      <Button href="/writing" variant="secondary" class="self-start sm:self-auto">
        All Writing →
      </Button>
    </header>

    <div class="space-y-12">
      {
        recentPosts.map((post, index) => (
          <WritingPostCard
            post={post}
            headingLevel="h3"
            class={`reveal ${index === 1 ? 'delay-150' : ''}`}
          />
        ))
      }
    </div>
  </Container>

  <Container as="section" class="py-20">
    <div class="reveal max-w-3xl border border-(--border-color) bg-(--bg-primary) p-8 md:p-12">
      <Typography variant="eyebrow">How I Work</Typography>
      <Typography variant="h2" class="mb-4">Good development starts with structure</Typography>
      <Typography variant="body" class="mb-6 text-(--text-muted)">
        I like structure. Good DevOps and a dependable platform make it easier to take software from
        an idea to a release, then keep improving it over time. When builds, tests, and releases are
        predictable, the code is easier to change and maintain.
      </Typography>
      <Button href={mailto} variant="primary">Get in touch</Button>
    </div>
  </Container>
</Layout>

<script>
  let revealObserver: IntersectionObserver | null = null;

  function initScrollReveal() {
    // The bare call below is load-bearing: astro:page-load fires on window `load`,
    // by which point the page has painted, so hiding there would flash the content
    // in and straight back out. This guard stops that later run from re-hiding
    // what has already been revealed, and from stacking a second observer.
    if (revealObserver) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const elements = document.querySelectorAll<HTMLElement>('.reveal');

    if (prefersReducedMotion || elements.length === 0) return;

    elements.forEach((el) => el.classList.add('reveal-hidden'));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.remove('reveal-hidden');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
    );

    revealObserver = observer;
    elements.forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:before-swap', () => {
    revealObserver?.disconnect();
    revealObserver = null;
  });

  initScrollReveal();
  document.addEventListener('astro:page-load', initScrollReveal);
</script>
